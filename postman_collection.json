{
  "info": {
    "name": "Webcomics Tracker V2 - REST API",
    "description": "Postman Collection untuk menguji seluruh endpoint CRUD MongoDB dan integrasi MangaDex External API (Final Project Study Club Backend Basic KSM Veterantech UPNVJ 2026).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "comicId",
      "value": "REPLACE_WITH_MONGODB_ID",
      "type": "string"
    },
    {
      "key": "mangadexId",
      "value": "32d76d19-8a05-4db0-9fc2-e0b0648fe9d0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check (Root)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "1. Create Comic (Manual)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"One Piece\",\n  \"author\": \"Eiichiro Oda\",\n  \"genre\": [\"Adventure\", \"Action\", \"Fantasy\"],\n  \"status\": \"Reading\",\n  \"currentChapter\": 1120,\n  \"totalChapters\": 1130,\n  \"rating\": 9.8,\n  \"notes\": \"World-building luar biasa!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/comics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics"]
        }
      }
    },
    {
      "name": "2. Get All Comics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics"]
        }
      }
    },
    {
      "name": "3. Search & Filter Comics (Query Params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comics?search=one&status=Reading&sort=rating",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics"],
          "query": [
            { "key": "search", "value": "one" },
            { "key": "status", "value": "Reading" },
            { "key": "sort", "value": "rating" }
          ]
        }
      }
    },
    {
      "name": "4. Get Comic By ID (Path Param)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comics/{{comicId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics", "{{comicId}}"]
        }
      }
    },
    {
      "name": "5. Update Comic By ID",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentChapter\": 1125,\n  \"rating\": 9.9,\n  \"notes\": \"Elbaf arc semakin seru!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/comics/{{comicId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics", "{{comicId}}"]
        }
      }
    },
    {
      "name": "6. Delete Comic By ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comics/{{comicId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics", "{{comicId}}"]
        }
      }
    },
    {
      "name": "7. Get Collection Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/comics/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "comics", "stats"]
        }
      }
    },
    {
      "name": "8. External: Search MangaDex API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mangadex/search?title=Solo Leveling&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "mangadex", "search"],
          "query": [
            { "key": "title", "value": "Solo Leveling" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "9. External: Import Manga from MangaDex to MongoDB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Reading\",\n  \"currentChapter\": 50,\n  \"rating\": 9.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/mangadex/import/{{mangadexId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "mangadex", "import", "{{mangadexId}}"]
        }
      }
    }
  ]
}
